#!/usr/bin/env bash
# secrets - Tiered macOS keychain CLI
# Usage: secrets <command> [args...]

set -euo pipefail

# Resolve symlinks so SCRIPT_DIR points to the real script location, not
# the symlink that brew creates in /opt/homebrew/bin or that bin/secrets-helper
# is when running from source. Without this, ../VERSION resolves wrong
# under brew install.
_kb_src="${BASH_SOURCE[0]}"
while [[ -h "$_kb_src" ]]; do
    _kb_dir="$(cd -P "$(dirname "$_kb_src")" && pwd)"
    _kb_src="$(readlink "$_kb_src")"
    [[ "$_kb_src" != /* ]] && _kb_src="$_kb_dir/$_kb_src"
done
readonly SCRIPT_DIR="$(cd -P "$(dirname "$_kb_src")" && pwd)"
unset _kb_src _kb_dir

# Resolve secbak.py (source: ../lib, brew: ../libexec/lib)
_secbak_py() {
    local c
    for c in "$SCRIPT_DIR/../lib/secbak.py" "$SCRIPT_DIR/../libexec/lib/secbak.py"; do
        [[ -f "$c" ]] && { echo "$c"; return 0; }
    done
    echo "Error: secbak.py not found (backup and restore need lib/secbak.py)" >&2
    return 1
}

readonly CONFIG_FILE="${SECRETS_HELPER_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/secrets-helper/config.sh}"
# Detect invocation name so usage messages match `secrets ...` or `secrets-helper ...`.
readonly INVOKED_AS="$(basename "${0:-secrets}")"

# Find VERSION file. Works both when run from source (../VERSION) and
# when installed via Homebrew (../libexec/VERSION).
_kb_vf=""
for _kb_c in "$SCRIPT_DIR/../VERSION" "$SCRIPT_DIR/../libexec/VERSION"; do
    if [[ -f "$_kb_c" ]]; then
        _kb_vf="$_kb_c"
        break
    fi
done
readonly VERSION_FILE="$_kb_vf"
unset _kb_vf _kb_c

# --version is handled before requiring the config to exist.
if [[ "${1:-}" == "--version" || "${1:-}" == "-v" ]]; then
    if [[ -f "$VERSION_FILE" ]]; then
        echo "secrets-helper $(cat "$VERSION_FILE")"
    else
        echo "secrets-helper (version unknown — VERSION file missing)"
    fi
    exit 0
fi

if [[ ! -f "$CONFIG_FILE" ]]; then
    echo "Error: config not found at $CONFIG_FILE" >&2
    echo "Run setup.sh from the secrets-helper repo first." >&2
    exit 1
fi

# The config is read with `source`, so it could run code (security review
# 2026-10-01, fix 8). It is only read when it is yours, not writable by
# anyone else, and holds nothing but literal lists of the known keys: no $,
# no backticks, no commands. Then sourcing it can do nothing but assign.
_config_ok() {
    local f="$1" owner mode line
    owner=$(stat -f '%Su' "$f" 2>/dev/null || stat -c '%U' "$f" 2>/dev/null)
    mode=$(stat -f '%Lp' "$f" 2>/dev/null || stat -c '%a' "$f" 2>/dev/null)
    if [[ "$owner" != "$(id -un)" ]]; then
        echo "Error: $f belongs to '$owner', not to you; not reading it." >&2; return 1
    fi
    if (( (8#$mode & 8#022) != 0 )); then
        echo "Error: $f can be changed by others (mode $mode); run: chmod go-w '$f'" >&2; return 1
    fi
    local item='("([^"\\$`]|\\[^$`])*"|'"'"'[^'"'"']*'"'"'|[A-Za-z0-9._@:+-]+)'
    local re="^(TIER_NAMES|TIER_POLICIES|TIER_DESCS|NEVER_PULL_TIERS)=\\([[:space:]]*(${item}[[:space:]]*)*\\)[[:space:]]*$"
    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ "$line" =~ ^[[:space:]]*(#.*)?$ ]] && continue
        if ! [[ "$line" =~ $re ]]; then
            echo "Error: $f has a line secrets-helper will not run:" >&2
            echo "  $line" >&2
            echo "  Only TIER_NAMES, TIER_POLICIES, TIER_DESCS and NEVER_PULL_TIERS lists of" >&2
            echo "  plain text are allowed (no \$, no backticks, no commands)." >&2
            return 1
        fi
    done < "$f"
}
_config_ok "$CONFIG_FILE" || exit 1
# shellcheck disable=SC1090
source "$CONFIG_FILE"

# The ssh binary, injectable so the test suite can stand in for a remote host.
readonly SECRETS_SSH="${SECRETS_SSH:-ssh}"

# Where keychains live. Overridable so the test suite can work in a temp dir
# instead of the real ~/Library/Keychains.
readonly KEYCHAIN_DIR="${SECRETS_KEYCHAIN_DIR:-$HOME/Library/Keychains}"

# Tiers that must never be copied to another machine, whatever the caller asks.
# The case this exists for is a tier holding credentials known to be leaked and
# awaiting revocation: copying those to a second machine spreads the problem
# instead of ending it. Set NEVER_PULL_TIERS in your config to match whatever you
# called yours; "quarantine" is only the default guess.
never_pull_tier() {
    local tier="$1" t
    for t in "${NEVER_PULL_TIERS[@]:-quarantine}"; do
        [[ "$t" == "$tier" ]] && return 0
    done
    return 1
}

tier_keychain_path() {
    local tier="$1"
    for n in "${TIER_NAMES[@]}"; do
        if [[ "$n" == "$tier" ]]; then
            echo "$KEYCHAIN_DIR/${tier}.keychain-db"
            return 0
        fi
    done
    echo "Error: unknown tier '$tier'" >&2
    echo "Available tiers: ${TIER_NAMES[*]}" >&2
    return 1
}

tier_policy() {
    local tier="$1" i
    for i in "${!TIER_NAMES[@]}"; do
        if [[ "${TIER_NAMES[$i]}" == "$tier" ]]; then
            echo "${TIER_POLICIES[$i]}"
            return 0
        fi
    done
    echo "2"
}

# Create the keychain for a tier that is configured but not yet materialised —
# a fresh machine, or a tier added to the config by hand. Mirrors setup.sh's
# create_keychain so both paths produce the same thing.
#
# The password is the whole security story: an empty one keeps the tier
# auto-unlocking, which is exactly what lets `pull` read it over ssh. That is a
# choice the person in front of the machine makes, so it is asked, never assumed.
create_tier_keychain() {
    local tier="$1" kc="$2" policy password
    policy=$(tier_policy "$tier")

    echo "Tier '$tier' is configured but has no keychain on this machine yet."
    echo
    echo "  An EMPTY password means the tier unlocks by itself. That is what makes"
    echo "  'secrets pull' able to read it, and equally what makes it readable by"
    echo "  anything else with access to this account. Keep such a tier for"
    echo "  low-risk credentials — never for infrastructure passwords."
    echo
    read -r -s -p "  Password for '$tier' (empty = auto-unlock): " password
    echo
    # The password goes to `security -i` on stdin, never as `-p` on a command
    # line (security review 2026-10-01, fix 2). Empty stays possible.
    local q=${password//\\/\\\\}; q=${q//\"/\\\"}
    printf 'create-keychain -p "%s" "%s"\n' "$q" "$kc" | security -i >/dev/null 2>&1
    unset password q
    [[ -f "$kc" ]] || { echo "Error: could not create the keychain for '$tier'" >&2; return 1; }

    case "$policy" in
        1) security set-keychain-settings "$kc" ;;
        2) security set-keychain-settings -l -t 3600 "$kc" ;;
        3) security set-keychain-settings -l -t 1 "$kc" ;;
    esac

    # Join the user search list, or `security` will not find it without a path.
    local current
    current=$(security list-keychains -d user | sed -e 's/^[[:space:]]*"//' -e 's/"$//' | tr '\n' ' ')
    # shellcheck disable=SC2086
    security list-keychains -d user -s $current "$kc" >/dev/null

    echo "Created '$tier'."
    echo
}

usage() {
    cat <<EOF
Usage: $INVOKED_AS <command> [args]

Commands:
  get TIER NAME              Print secret value
  add TIER NAME              Add or update a secret; the value is read from
                             stdin (hidden when typed), never an argument
  del TIER NAME              Delete a secret
  list TIER                  List secret names in a tier
  tiers                      List configured tiers
  lock TIER                  Lock a keychain
  unlock TIER                Unlock a keychain (prompts for password)
  remote-list HOST TIER      List secret names on another machine
  create-tier TIER           Create the keychain for a configured tier
  move FROM TO NAME          Move a secret to another tier [--force]
  pull HOST TIER NAME|GLOB   Copy secret(s) from another machine [--force]
  backup [opts] [TIER...]    Encrypted .secbak backup of tiers (default: all)
  restore [opts] FILE        Restore keychains from a .secbak

backup options:
  --out FILE                 Output path (default: ~/secrets-YYYYMMDD.secbak)
  --openssl-compat           Write openssl-decryptable CBC blob + .sha256 (no AEAD)
restore options:
  --dest DIR                 Target dir (default: ~/Library/Keychains)
  --force                    Move-aside existing keychains, then overwrite

Backup password (layer 1) via \$SECRETS_BACKUP_PASSWORD or prompt.
  help                       Show this help
  --version, -v              Show version

backup options:
  --out FILE                 Output path (default: ~/secrets-YYYYMMDD.secbak)
  --openssl-compat           Write openssl-decryptable CBC blob + .sha256 (no AEAD)
restore options:
  --dest DIR                 Target dir (default: ~/Library/Keychains)
  --force                    Move-aside existing keychains, then overwrite

Backup password (layer 1) via \$SECRETS_BACKUP_PASSWORD or prompt.

Configured tiers: ${TIER_NAMES[*]}
EOF
}

cmd_get() {
    [[ $# -eq 2 ]] || { echo "Usage: $INVOKED_AS get TIER NAME" >&2; exit 1; }
    local kc v; kc=$(tier_keychain_path "$1") || exit 1
    if v=$(security find-generic-password -a "$USER" -s "$2" -w "$kc" 2>/dev/null); then
        printf '%s\n' "$v"; unset v; return 0
    fi
    # Every keychain but login starts locked after a reboot, and "auto-unlock"
    # only means it never locks again once open (security review 2026-10-01,
    # fix 5). An auto-unlock tier has an empty password: open it and retry.
    if ! security find-generic-password -a "$USER" -s "$2" "$kc" >/dev/null 2>&1; then
        echo "Error: '$2' not found in '$1'" >&2; exit 1
    fi
    if [[ "$(tier_policy "$1")" == 1 ]] && security unlock-keychain -p "" "$kc" 2>/dev/null \
        && v=$(security find-generic-password -a "$USER" -s "$2" -w "$kc" 2>/dev/null); then
        printf '%s\n' "$v"; unset v; return 0
    fi
    echo "Error: '$1' is locked. Open it with: $INVOKED_AS unlock $1" >&2
    exit 1
}

# _store NAME VALUE KEYCHAIN: write an item without the value ever becoming an
# argument. `security add-generic-password -w VALUE` shows the value to anyone
# who lists processes; `security -i` reads the same command from stdin. The
# value is quoted for security's parser (\\ and " escaped, inside "...").
_store() {
    local name="$1" value="$2" kc="$3" q qn
    q=${value//\\/\\\\}; q=${q//\"/\\\"}
    qn=${name//\\/\\\\}; qn=${qn//\"/\\\"}
    printf 'add-generic-password -U -a "%s" -s "%s" -w "%s" "%s"\n' "$USER" "$qn" "$q" "$kc" \
        | security -i >/dev/null 2>&1
    unset q value
    # security -i does not return the inner command's status: verify by reading back
    [[ "$(security find-generic-password -a "$USER" -s "$name" -w "$kc" 2>/dev/null)" == "$2" ]]
}

cmd_add() {
    if [[ $# -eq 3 ]]; then
        echo "Error: the value is no longer an argument (it showed in process lists and shell history)." >&2
        echo "  Type it:      $INVOKED_AS add $1 $2          (asks, hidden)" >&2
        echo "  Or pipe it:   <command that prints it> | $INVOKED_AS add $1 $2" >&2
        exit 1
    fi
    [[ $# -eq 2 ]] || { echo "Usage: $INVOKED_AS add TIER NAME   (the value comes from stdin, hidden when typed)" >&2; exit 1; }
    local kc; kc=$(tier_keychain_path "$1") || exit 1
    local value=""
    if [[ -t 0 ]]; then
        read -r -s -p "Value for '$2' in '$1': " value; echo >&2
    else
        IFS= read -r value || true   # a last line without a newline still counts
    fi
    [[ -n "$value" ]] || { echo "Error: empty value, nothing stored" >&2; exit 1; }
    _store "$2" "$value" "$kc" || { unset value; echo "Error: could not store '$2' in '$1'" >&2; exit 1; }
    unset value
    echo "Added '$2' to '$1'"
}

cmd_del() {
    [[ $# -eq 2 ]] || { echo "Usage: $INVOKED_AS del TIER NAME" >&2; exit 1; }
    local kc; kc=$(tier_keychain_path "$1") || exit 1
    security delete-generic-password -a "$USER" -s "$2" "$kc" >/dev/null
    echo "Deleted '$2' from '$1'"
}

cmd_list() {
    [[ $# -eq 1 ]] || { echo "Usage: $INVOKED_AS list TIER" >&2; exit 1; }
    local kc; kc=$(tier_keychain_path "$1") || exit 1
    security dump-keychain "$kc" 2>/dev/null \
        | awk -F'"' '/"svce"<blob>=/{print $4}' \
        | sort -u
}

# Everything below runs on the OTHER machine. Two things make it work:
#
#   1. An ssh session is not attached to your logged-in GUI session, so the
#      keychain is closed and reads fail with "User interaction is not allowed".
#      An explicit unlock fixes that — for tiers whose keychain has an empty
#      password, which is what an auto-unlock tier means in practice.
#   2. A tier with a real password cannot be unlocked non-interactively at all.
#      That is the security boundary, and it is the existing one: this command
#      does not decide which tiers are reachable, the keychain passwords do.
# A key name as it may travel to another machine: it is pasted into the script
# that runs there, so only these characters, checked on both ends (security
# review 2026-10-01, fix 3). A name with a quote in it ran code on the other
# Mac right after its keychain was unlocked.
_valid_name() { [[ "$1" =~ ^[A-Za-z0-9._@:-]+$ ]]; }

_remote_script() {
    local tier="$1" op="$2" name="${3:-}"
    if [[ "$op" == __get ]] && ! _valid_name "$name"; then
        echo "internal: refusing to send name '$name'" >&2; return 1
    fi
    # Only the branch being asked for is sent, so the wire carries the minimum
    # and the script reads as what it does.
    local body
    case "$op" in
        __list) body="security dump-keychain \"\$kc\" 2>/dev/null | awk -F'\"' '/\"svce\"<blob>=/{print \$4}' | sort -u" ;;
        __get)  body="security find-generic-password -a \"\$USER\" -s '${name}' -w \"\$kc\" 2>/dev/null || { echo __not_found >&2; exit 5; }" ;;
        *)      echo "internal: unknown remote op $op" >&2; return 1 ;;
    esac
    cat <<EOF
kc="\$HOME/Library/Keychains/${tier}.keychain-db"
[ -f "\$kc" ] || { echo __no_such_tier >&2; exit 3; }
security unlock-keychain -p "" "\$kc" 2>/dev/null || { echo __locked >&2; exit 4; }
${body}
EOF
}

# Run one remote operation. Maps the remote exit codes onto messages that say
# what to do, and never echoes a value on any path.
_remote() {
    local host="$1" tier="$2" op="$3" name="${4:-}" out rc script
    # A host that starts with - would reach ssh as an option (-oProxyCommand=...
    # runs a command here); `--` ends ssh's options (fix 4).
    if [[ -z "$host" || "$host" == -* ]]; then
        echo "Error: '$host' is not a host name" >&2; return 1
    fi
    script=$(_remote_script "$tier" "$op" "$name") || return 1
    out=$("$SECRETS_SSH" -- "$host" "$script" 2>"$TMP_ERR")
    rc=$?
    if [[ $rc -ne 0 ]]; then
        local err first
        err=$(cat "$TMP_ERR" 2>/dev/null)
        first=$(printf '%s' "$err" | head -1)
        case "$err" in
            *__no_such_tier*) echo "Error: tier '$tier' does not exist on $host" >&2 ;;
            *__locked*)       echo "Error: could not unlock '$tier' on $host — that keychain has a password." >&2
                              echo "       Copy it by hand, or run the pull from a session that can unlock it." >&2 ;;
            *__not_found*)    echo "Error: '$name' not found in '$tier' on $host" >&2 ;;
            *)                echo "Error: cannot reach $host — $first" >&2 ;;
        esac
        return 1
    fi
    printf '%s' "$out"
}

# Move a secret from one tier to another on this machine.
#
# The ordering is the whole point: copy, read the copy back and compare, and only
# then delete the original. Every failure path leaves the source intact, because
# the thing being moved is typically a credential you cannot simply re-issue —
# a server password, a registrar key. Losing one to a half-finished write would
# be far worse than leaving it in the wrong tier for another day.
cmd_move() {
    local force=0 args=()
    for a in "$@"; do
        if [[ "$a" == "--force" ]]; then force=1; else args+=("$a"); fi
    done
    [[ ${#args[@]} -eq 3 ]] || { echo "Usage: $INVOKED_AS move FROM_TIER TO_TIER NAME [--force]" >&2; exit 1; }
    local from="${args[0]}" to="${args[1]}" name="${args[2]}"

    [[ "$from" != "$to" ]] || { echo "Error: source and target are the same tier ('$from')" >&2; exit 1; }

    local from_kc to_kc
    from_kc=$(tier_keychain_path "$from") || exit 1
    to_kc=$(tier_keychain_path "$to") || exit 1

    [[ -f "$from_kc" ]] || { echo "Error: tier '$from' has no keychain on this machine." >&2; exit 1; }

    if [[ ! -f "$to_kc" ]]; then
        if [[ -t 0 ]]; then
            create_tier_keychain "$to" "$to_kc" || exit 1
        else
            echo "Error: tier '$to' has no keychain yet. Run '$INVOKED_AS create-tier $to' first." >&2
            exit 1
        fi
    fi

    # Read the source first: if it is not there, nothing else needs to happen.
    local value
    if ! value=$(security find-generic-password -a "$USER" -s "$name" -w "$from_kc" 2>/dev/null); then
        echo "Error: '$name' not found in '$from'" >&2
        exit 1
    fi

    if [[ $force -eq 0 ]] && security find-generic-password -a "$USER" -s "$name" "$to_kc" >/dev/null 2>&1; then
        unset value
        echo "Error: '$name' already exists in '$to' — pass --force to overwrite it." >&2
        exit 1
    fi

    # A protected target tier is closed until someone opens it. That prompt is the
    # feature, not an obstacle: it is why the credential is going there.
    if ! security unlock-keychain "$to_kc" 2>/dev/null; then
        unset value
        echo "Error: could not unlock '$to' — nothing moved, '$name' is still in '$from'." >&2
        exit 1
    fi

    if ! _store "$name" "$value" "$to_kc"; then
        unset value
        echo "Error: could not write '$name' to '$to' — not moved, still in '$from'." >&2
        exit 1
    fi

    # Verify by reading the copy back. A write that silently stored something else
    # would otherwise be followed by deleting the only good copy.
    local check
    check=$(security find-generic-password -a "$USER" -s "$name" -w "$to_kc" 2>/dev/null || true)
    if [[ "$check" != "$value" ]]; then
        unset value check
        echo "Error: '$name' failed verification in '$to' — not moved, still in '$from'." >&2
        echo "       Inspect '$to' before retrying; a partial copy may be there." >&2
        exit 1
    fi
    unset value check

    security delete-generic-password -a "$USER" -s "$name" "$from_kc" >/dev/null 2>&1 || {
        echo "Warning: '$name' was copied to '$to' but could not be removed from '$from'." >&2
        echo "         It now exists in both. Remove it with: $INVOKED_AS del $from $name" >&2
        exit 1
    }

    echo "Moved '$name': $from -> $to"
}

cmd_create_tier() {
    [[ $# -eq 1 ]] || { echo "Usage: $INVOKED_AS create-tier TIER" >&2; exit 1; }
    local kc; kc=$(tier_keychain_path "$1") || exit 1
    if [[ -f "$kc" ]]; then
        echo "Tier '$1' already exists at $kc"
        exit 0
    fi
    create_tier_keychain "$1" "$kc" || exit 1
}

cmd_remote_list() {
    [[ $# -eq 2 ]] || { echo "Usage: $INVOKED_AS remote-list HOST TIER" >&2; exit 1; }
    tier_keychain_path "$2" >/dev/null || exit 1
    _remote "$1" "$2" __list || exit 1
}

cmd_pull() {
    local force=0 args=()
    for a in "$@"; do
        if [[ "$a" == "--force" ]]; then force=1; else args+=("$a"); fi
    done
    [[ ${#args[@]} -eq 3 ]] || { echo "Usage: $INVOKED_AS pull HOST TIER NAME|GLOB [--force]" >&2; exit 1; }
    local host="${args[0]}" tier="${args[1]}" pattern="${args[2]}"

    if never_pull_tier "$tier"; then
        echo "Refusing to pull from '$tier': it holds credentials pending revocation." >&2
        echo "Copying those to another machine spreads the problem instead of ending it." >&2
        exit 1
    fi

    local kc; kc=$(tier_keychain_path "$tier") || exit 1

    # Make sure there is somewhere to put things BEFORE anything leaves the other
    # machine. A tier can be configured here and still have no keychain — a fresh
    # laptop is exactly that. Without this the secret would travel and then be
    # dropped, and macOS reports that as "User interaction is not allowed", which
    # points at entirely the wrong problem.
    if [[ ! -f "$kc" ]]; then
        if [[ -t 0 ]]; then
            create_tier_keychain "$tier" "$kc" || exit 1
        else
            echo "Error: tier '$tier' has no keychain on this machine yet." >&2
            echo "       Run '$INVOKED_AS create-tier $tier' first (it needs a terminal)." >&2
            exit 1
        fi
    fi

    # Resolve the pattern remotely, so one glob costs one extra round trip
    # rather than one guess per candidate name.
    local names
    if [[ "$pattern" == *[\*\?]* ]]; then
        [[ "$pattern" =~ ^[A-Za-z0-9._@:*?-]+$ ]] || { echo "Error: '$pattern' has characters a key name cannot have" >&2; exit 1; }
        local all; all=$(_remote "$host" "$tier" __list) || exit 1
        # `|| true` is load-bearing under `set -e`: the loop ends on a failing
        # `read` at EOF, and that status would otherwise abort the whole script.
        names=$(printf '%s\n' "$all" | while read -r n; do
            [[ -n "$n" ]] || continue
            # the other machine's answer is data: a name that could not be sent
            # back safely is left out, and said so
            _valid_name "$n" || { echo "  (skipped a name from $host with unexpected characters)" >&2; continue; }
            # $pattern is meant to be a glob here, not a literal.
            # shellcheck disable=SC2053
            [[ "$n" == $pattern ]] && echo "$n"
        done) || true
        [[ -n "$names" ]] || { echo "No keys on $host match '$pattern'"; exit 0; }
        local n_match
        n_match=$(printf '%s\n' "$names" | grep -c .)
        echo "$n_match key/keys on $host match '$pattern':"
        printf '%s\n' "$names" | sed 's/^/  /' 
    else
        _valid_name "$pattern" || { echo "Error: '$pattern' has characters a key name cannot have" >&2; exit 1; }
        names="$pattern"
    fi

    # Open the target once, up front. A tier created moments ago is not
    # necessarily unlocked, and without this the first write fails — which is how
    # a two-key pull quietly delivered one key. Silent by design: a protected tier
    # simply will not open, and the per-key error below says so.
    security unlock-keychain -p "" "$kc" 2>/dev/null || true

    # Three outcomes, not two. "Skipped" means you already had it, which is fine.
    # "Failed" means the value was fetched and could not be stored, which is not —
    # reporting both as skipped is what let a missing key look like success.
    local pulled=0 skipped=0 failed=0
    while read -r name; do
        [[ -n "$name" ]] || continue
        if [[ $force -eq 0 ]] && security find-generic-password -a "$USER" -s "$name" "$kc" >/dev/null 2>&1; then
            echo "  $name — skipped (already here; --force to overwrite)"
            skipped=$((skipped+1))
            continue
        fi
        local value
        value=$(_remote "$host" "$tier" __get "$name") || { failed=$((failed+1)); continue; }
        [[ -n "$value" ]] || { echo "  $name — failed (empty value on $host)" >&2; failed=$((failed+1)); continue; }
        if ! _store "$name" "$value" "$kc"; then
            unset value
            echo "  $name — failed to store in '$tier' locally" >&2
            failed=$((failed+1))
            continue
        fi
        unset value
        echo "  $name — pulled"
        pulled=$((pulled+1))
    done <<< "$names"

    local summary="$pulled pulled, $skipped skipped"
    [[ $failed -gt 0 ]] && summary="$summary, $failed FAILED"
    echo "$summary"

    # A non-zero exit so a script above this one notices, and so a partial pull
    # cannot pass for a complete one.
    [[ $failed -eq 0 ]]
}

cmd_tiers() {
    printf "%-20s %-12s %s\n" "NAME" "POLICY" "DESCRIPTION"
    for i in "${!TIER_NAMES[@]}"; do
        local policy_label
        case "${TIER_POLICIES[$i]}" in
            1) policy_label="auto-unlock" ;;
            2) policy_label="session" ;;
            3) policy_label="prompt" ;;
            *) policy_label="?" ;;
        esac
        printf "%-20s %-12s %s\n" "${TIER_NAMES[$i]}" "$policy_label" "${TIER_DESCS[$i]}"
    done
}

cmd_lock() {
    [[ $# -eq 1 ]] || { echo "Usage: $INVOKED_AS lock TIER" >&2; exit 1; }
    local kc; kc=$(tier_keychain_path "$1") || exit 1
    security lock-keychain "$kc"
    echo "Locked '$1'"
}

cmd_unlock() {
    [[ $# -eq 1 ]] || { echo "Usage: $INVOKED_AS unlock TIER" >&2; exit 1; }
    local kc; kc=$(tier_keychain_path "$1") || exit 1
    security unlock-keychain "$kc"
    echo "Unlocked '$1'"
}

# Scratch file for remote stderr. Created per run, removed on exit.
TMP_ERR=$(mktemp)
trap 'rm -f "$TMP_ERR"' EXIT

# The backup password stays in this shell: python gets it on stdin, and it is
# never exported to child processes (security review 2026-10-01, fix 7).
# A SECRETS_BACKUP_PASSWORD the user set is used, and kept from python's
# environment too.
BACKUP_PW=""
_ensure_backup_password() {
    BACKUP_PW="${SECRETS_BACKUP_PASSWORD:-}"
    if [[ -z "$BACKUP_PW" ]]; then
        read -rs -p "Backup password (layer 1): " BACKUP_PW; echo >&2
    fi
    [[ -n "$BACKUP_PW" ]] || { echo "Error: empty backup password" >&2; return 1; }
}
# backup and restore need python3 with the cryptography package; say so
# before asking for a password, instead of a python traceback after it
_secbak_deps() {
    command -v python3 >/dev/null 2>&1 || { echo "Error: backup and restore need python3" >&2; return 1; }
    python3 -c 'import cryptography' 2>/dev/null || {
        echo "Error: backup and restore need the Python package 'cryptography':" >&2
        echo "  python3 -m pip install --user cryptography" >&2
        return 1
    }
}
_secbak() { # _secbak <secbak args...>: the password on stdin, not in the environment
    printf '%s' "$BACKUP_PW" | env -u SECRETS_BACKUP_PASSWORD python3 "$@" --password-stdin
    local rc=$?; BACKUP_PW=""; return $rc
}

cmd_backup() {
    local out="" compat="" tiers=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --out) out="$2"; shift 2 ;;
            --openssl-compat) compat="--openssl-compat"; shift ;;
            -*) echo "Unknown backup option: $1" >&2; return 1 ;;
            *) tiers+=("$1"); shift ;;
        esac
    done
    [[ ${#tiers[@]} -eq 0 ]] && tiers=("${TIER_NAMES[@]}")
    [[ -n "$out" ]] || out="$HOME/secrets-$(date +%Y%m%d).secbak"
    local paths=() t kc
    for t in "${tiers[@]}"; do
        kc=$(tier_keychain_path "$t") || return 1
        if [[ -f "$kc" ]]; then paths+=("$kc"); else echo "Warning: $kc not found, skipping" >&2; fi
    done
    [[ ${#paths[@]} -gt 0 ]] || { echo "Error: no keychains to back up" >&2; return 1; }
    local py; py=$(_secbak_py) || return 1
    _secbak_deps || return 1
    _ensure_backup_password || return 1
    _secbak "$py" pack --out "$out" $compat "${paths[@]}"
}

cmd_restore() {
    local dest="$HOME/Library/Keychains" force="" file=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dest) dest="$2"; shift 2 ;;
            --force) force="--force"; shift ;;
            -*) echo "Unknown restore option: $1" >&2; return 1 ;;
            *) file="$1"; shift ;;
        esac
    done
    [[ -n "$file" ]] || { echo "Usage: $INVOKED_AS restore [--dest DIR] [--force] FILE" >&2; return 1; }
    [[ -f "$file" ]] || { echo "Error: $file not found" >&2; return 1; }
    local py; py=$(_secbak_py) || return 1
    _secbak_deps || return 1
    _ensure_backup_password || return 1
    _secbak "$py" restore --dest "$dest" $force "$file" || return 1
    if [[ "$dest" == "$HOME/Library/Keychains" ]]; then
        # Add the tiers to the search list; never replace it: the list also holds
        # keychains secrets-helper does not know about (security review, fix 6).
        local list=() add=() t k have
        while IFS= read -r k; do list+=("$k"); done < <(security list-keychains -d user | sed -e 's/^[[:space:]]*"//' -e 's/"$//')
        for t in "${TIER_NAMES[@]}"; do
            k="$HOME/Library/Keychains/${t}.keychain-db"; have=0
            for e in "${list[@]}"; do [[ "$e" == "$k" ]] && have=1; done
            [[ -f "$k" && $have -eq 0 ]] && add+=("$k")
        done
        if [[ ${#add[@]} -gt 0 ]]; then
            security list-keychains -d user -s "${list[@]}" "${add[@]}" 2>/dev/null || true
        fi
        echo "Note: restored keychains are still locked with their own (layer-2) password." >&2
    fi
}

main() {
    [[ $# -ge 1 ]] || { usage; exit 1; }
    local cmd="$1"; shift
    case "$cmd" in
        get) cmd_get "$@" ;;
        add) cmd_add "$@" ;;
        del|delete|rm) cmd_del "$@" ;;
        list|ls) cmd_list "$@" ;;
        tiers) cmd_tiers ;;
        lock) cmd_lock "$@" ;;
        unlock) cmd_unlock "$@" ;;
        pull) cmd_pull "$@" ;;
        remote-list) cmd_remote_list "$@" ;;
        create-tier) cmd_create_tier "$@" ;;
        move|promote) cmd_move "$@" ;;
        backup) cmd_backup "$@" ;;
        restore) cmd_restore "$@" ;;
        help|-h|--help) usage ;;
        --version|-v)
            if [[ -f "$VERSION_FILE" ]]; then
                echo "secrets-helper $(cat "$VERSION_FILE")"
            else
                echo "secrets-helper (version unknown)"
            fi
            ;;
        *) echo "Unknown command: $cmd" >&2; usage; exit 1 ;;
    esac
}

main "$@"
